# WealthOS production environment template (legacy path).
# Preferred production env: docker/.env.production (see docker/.env.production.example).
# Copy to .env for backend/docker experiments. Never commit real values.

POSTGRES_DB=wealthos
POSTGRES_USER=wealthos
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

JWT_ISSUER=https://api.wealthos.devenlight.com
JWT_AUDIENCE=wealthos-api
JWT_SECRET_KEY=CHANGE_ME_MIN_32_CHAR_RANDOM_SECRET_KEY
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

CORS_ORIGIN_0=https://wealthos.devenlight.com

HANGFIRE_WORKER_COUNT=2

ADMIN_SEED_EMAIL=admin@devenlight.com
ADMIN_SEED_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
ADMIN_SEED_FIRST_NAME=System
ADMIN_SEED_LAST_NAME=Admin

ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PASSWORD=
ANGELONE_TOTP_SECRET=
ANGELONE_ENABLE_LIVE_SYNC=false
ANGELONE_REFRESH_TOKEN_SECRET_NAME=

VITE_API_MODE=api
VITE_API_BASE_URL=https://api.wealthos.devenlight.com
VITE_API_VERSION=1
