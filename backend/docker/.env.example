# WealthOS production environment template
# Copy to .env on the Hostinger VPS and fill secrets. Never commit real values.

POSTGRES_DB=wealthos
POSTGRES_USER=wealthos
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

JWT_ISSUER=https://api.yourdomain.com
JWT_AUDIENCE=wealthos-api
JWT_SECRET_KEY=CHANGE_ME_MIN_32_CHAR_RANDOM_SECRET_KEY
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

CORS_ORIGIN_0=https://app.yourdomain.com

HANGFIRE_WORKER_COUNT=2

# Angel One SmartAPI (optional — leave empty to keep read-only stub)
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_ENABLE_LIVE_SYNC=false
ANGELONE_REFRESH_TOKEN_SECRET_NAME=

# TLS certs directory mounted into nginx (Let's Encrypt or Hostinger SSL)
TLS_CERT_DIR=./nginx/certs

# Frontend (Vite) — set on the static host / Cloudflare Pages / etc.
# Copy frontend/.env.production.example → frontend/.env.production
VITE_API_MODE=api
VITE_API_BASE_URL=https://api.yourdomain.com
VITE_API_VERSION=1
