{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=wealthos;Username=wealthos;Password=wealthos_dev_password"
  },
  "Jwt": {
    "Issuer": "https://api.wealthos.local",
    "Audience": "wealthos-api",
    "SecretKey": "CHANGE_ME_USE_ENVIRONMENT_VARIABLE_IN_PRODUCTION_32_CHARS_MIN",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "AdminSeed": {
    "Email": "admin@wealthos.local",
    "Password": "",
    "FirstName": "System",
    "LastName": "Admin"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "Hangfire": {
    "DashboardPath": "/hangfire",
    "WorkerCount": 0
  },
  "AI": {
    "DefaultProvider": "OpenAI",
    "EnableToolExecution": true,
    "MaxToolsPerTurn": 4
  },
  "AngelOne": {
    "BaseUrl": "https://apiconnect.angelone.in",
    "ApiKey": "",
    "ClientCode": "",
    "RefreshTokenSecretName": "",
    "EnableLiveSync": false
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
