# WealthOS frontend — copy to .env.local / .env.development / .env.production

# mock = modules serve local fixtures without network (local UI work)
# api  = ApiClient talks to the ASP.NET backend (required for production builds)
VITE_API_MODE=api

# Backend origin only (no trailing slash). Path version is appended by the client.
# Matches WealthOS.Api launch profile "http" (Properties/launchSettings.json).
VITE_API_BASE_URL=http://localhost:5095

# API version segment used in URLs: /api/v{version}/...
VITE_API_VERSION=1
