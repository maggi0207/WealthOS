# WealthOS frontend — copy to .env.local / .env.development / .env.production

# mock = Dashboard (and other modules) serve local fixtures without network
# api  = ApiClient talks to the ASP.NET backend (Dashboard is wired; other modules still mock)
VITE_API_MODE=mock

# Backend origin only (no trailing slash). Path version is appended by the client.
VITE_API_BASE_URL=http://localhost:5080

# API version segment used in URLs: /api/v{version}/...
VITE_API_VERSION=1
